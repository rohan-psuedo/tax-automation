# Copy to backend/.env and adjust. Every value is optional.

# Defaults to SQLite in backend/data/app.db. For several reviewers at once, use Postgres:
# DATABASE_URL=postgresql+psycopg://tax:tax@127.0.0.1:5432/tax_automaton   (uv sync --extra postgres)

# Session signing key. When unset, a random key is generated on first run and kept in
# backend/data/.secret_key.
# SECRET_KEY=

# TallyPrime's HTTP/XML server (F1 > Settings > Connectivity). Use 127.0.0.1, not localhost.
# TALLY_URL=http://127.0.0.1:9000

# Invoice reading (AI). Usually set in the app instead (Settings > Tally and AI), where a
# saved key, model or choice wins over these. Set the key of the service you use; with keys
# for several services and no AI_PROVIDER, the first of anthropic, gemini, openai,
# openrouter, groq, xai, deepseek, mistral, custom that is set up is used.
#
# Which service reads invoices: anthropic, gemini, openai, openrouter, groq, xai, deepseek,
# mistral or custom.
# AI_PROVIDER=gemini
# Model for that service (for Claude, use CLAUDE_MODEL instead).
# AI_MODEL=gemini-2.5-pro

# Claude (Anthropic): console.anthropic.com > API keys. Starts with sk-ant-.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Gemini (Google): aistudio.google.com > Get API key. GOOGLE_API_KEY is read too.
# GEMINI_API_KEY=

# OpenAI: platform.openai.com > API keys.
# OPENAI_API_KEY=

# OpenRouter (many models with one key): openrouter.ai > Keys. Starts with sk-or-.
# OPENROUTER_API_KEY=

# Groq: console.groq.com. xAI (Grok): console.x.ai. Mistral: console.mistral.ai.
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# DeepSeek: platform.deepseek.com. Reads text only, so scanned bills can't be read with it.
# DEEPSEEK_API_KEY=

# Other (OpenAI-compatible), e.g. Together, Fireworks, or Ollama / LM Studio on this
# network: set AI_PROVIDER=custom, its address and AI_MODEL, and a key if it needs one.
# AI_BASE_URL=http://192.168.1.30:11434/v1
# AI_API_KEY=

# Local development test account (created through the first-run setup screen):
#   email: admin@office.local   password: dev-admin-pass
